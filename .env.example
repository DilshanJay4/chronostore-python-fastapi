# Copy to `.env` and replace every placeholder. Never commit `.env`.

# development | testing | production
ENVIRONMENT=development

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_USER=chronostore
POSTGRES_PASSWORD=replace-with-a-local-db-password
POSTGRES_DB=chronostore
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000

# --- Application (used when running the API on the host with `uv run`) ---
DATABASE_URL=postgresql+psycopg://chronostore:replace-with-a-local-db-password@localhost:5433/chronostore
# Used by the test-suite (a separate database created by docker/postgres/init).
TEST_DATABASE_URL=postgresql+psycopg://chronostore:replace-with-a-local-db-password@localhost:5433/chronostore_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-output-of-secrets-token-urlsafe-64
JWT_ISSUER=chronostore-api
JWT_AUDIENCE=chronostore-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of exact origins, e.g. https://chronostore.lk,https://admin.chronostore.lk
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
# Set to false locally for human-readable console logs (must stay true in production).
LOG_JSON=true
LOG_SQL=false
DOCS_ENABLED=true

# Database pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Commerce rules (LKR)
SHIPPING_FLAT_FEE_LKR=500.00
FREE_SHIPPING_THRESHOLD_LKR=50000.00
RETURN_WINDOW_DAYS=14
ORDER_CONFIRMATION_TTL_HOURS=72

