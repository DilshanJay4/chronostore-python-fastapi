{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronostore.lk/schemas/v1/order-and-payment.schema.json",
  "title": "ChronoStore Order & Payment Schemas",
  "$defs": {
    "PaymentResponse": {
      "type": "object",
      "required": [
        "id",
        "order_id",
        "method",
        "status",
        "amount_lkr",
        "currency",
        "collected_at",
        "collection_reference",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "method": { "type": "string", "const": "cash_on_delivery" },
        "status": { "type": "string", "enum": ["pending", "collected", "failed", "voided"] },
        "amount_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "currency": { "type": "string", "const": "LKR" },
        "collected_at": { "type": ["string", "null"], "format": "date-time" },
        "collection_reference": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "OrderResponse": {
      "type": "object",
      "required": [
        "id",
        "order_number",
        "status",
        "subtotal_lkr",
        "shipping_fee_lkr",
        "total_lkr",
        "currency",
        "shipping_address_snapshot",
        "customer_notes",
        "cancellation_reason",
        "cancelled_at",
        "confirmed_at",
        "items",
        "payment",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "order_number": { "type": "string", "minLength": 5 },
        "status": {
          "type": "string",
          "enum": ["placed", "confirmed", "shipped", "delivered", "delivery_failed", "cancelled"]
        },
        "subtotal_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "shipping_fee_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "total_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "currency": { "type": "string", "const": "LKR" },
        "shipping_address_snapshot": { "type": "object" },
        "customer_notes": { "type": ["string", "null"] },
        "cancellation_reason": { "type": ["string", "null"] },
        "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "product_id",
              "product_sku",
              "product_name",
              "brand_name",
              "unit_price_lkr",
              "quantity",
              "line_total_lkr"
            ],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "product_id": { "type": ["string", "null"], "format": "uuid" },
              "product_sku": { "type": "string" },
              "product_name": { "type": "string" },
              "brand_name": { "type": "string" },
              "unit_price_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
              "quantity": { "type": "integer", "minimum": 1 },
              "line_total_lkr": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
            }
          }
        },
        "payment": {
          "oneOf": [
            { "$ref": "#/$defs/PaymentResponse" },
            { "type": "null" }
          ]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

